AZURE_TRANSLATOR_ENDPOINT=https://translator0kpmg0cca.cognitiveservices.azure.com/
AZURE_TRANSLATOR_KEY=yourkeyhere

# --- Only needed for the public/proxy deployment (docker-compose.prod.yml) ---
# The hostname Caddy serves on. Use your Azure DNS name for trusted HTTPS,
# e.g. yourlabel.eastus.cloudapp.azure.com  (or https://<public-ip> with `tls internal`)
SITE_ADDRESS=yourlabel.region.cloudapp.azure.com
# Basic-auth login shared with your users.
BASIC_AUTH_USER=admin
# bcrypt hash of the password (NOT the plaintext). Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_HASH=replace-with-bcrypt-hash

